SECRET_KEY=change-me-in-production
DEBUG=true
ALLOWED_HOSTS=127.0.0.1,localhost
DATABASE_URL=postgres://pdf_epub:pdf_epub@localhost:54329/pdf_epub
CELERY_BROKER_URL=redis://localhost:56379/0
CELERY_RESULT_BACKEND=redis://localhost:56379/1
CONVERTER_PARSER=native_pdf
# Optional: docling (heavy). Install with: pip install -e 'packages/converter[docling]'
# CONVERTER_PARSER=docling
# Optional: local OCR for scanned PDFs (notebook / CLI). Prefer Python 3.12.
# Fast on macOS (Homebrew tesseract): brew install tesseract
#   CONVERTER_OCR_ENGINE=tesseract
#   pip install -e "$(pwd)/packages/converter[ocr-tesseract]"
# Paddle (slow on Apple Silicon CPU; pin paddlepaddle==2.6.2):
#   pip install -e "$(pwd)/packages/converter[ocr]"
#   CONVERTER_OCR_ENGINE=paddle
# CONVERTER_PADDLE_LANG=es
# CONVERTER_PADDLE_USE_ANGLE_CLS=0
# CONVERTER_OCR_RENDER_SCALE=2.0
# CONVERTER_TESSERACT_LANG=eng
CONVERTER_WORK_DIR=backend/work
# EPUBCHECK_JAR=/path/to/epubcheck.jar
