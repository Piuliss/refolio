# PaddleOCR on NVIDIA GPU (CUDA 12.x) for Refolio converter smoke/batch OCR.
# Build: docker build -f deploy/Dockerfile.ocr-gpu -t refolio-ocr-gpu:2.6.2-cu12 .
# Run:  docker run --rm --gpus all -v ... refolio-ocr-gpu:2.6.2-cu12 ...

FROM nvidia/cuda:12.6.3-cudnn-runtime-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.12 \
    python3.12-venv \
    python3.12-dev \
    python3-pip \
    libgl1 \
    libglib2.0-0 \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.12 1 \
    && python3 -m pip install --no-cache-dir --break-system-packages pip==24.3.1

WORKDIR /app

COPY packages/converter /app/packages/converter

RUN python3 -m pip install --no-cache-dir --break-system-packages \
        paddlepaddle-gpu==2.6.2.post120 \
        -i https://www.paddlepaddle.org.cn/packages/stable/cu120/ \
    && python3 -m pip install --no-cache-dir --break-system-packages \
        "pymupdf>=1.25.5,<2" \
        "numpy>=1.26.0,<2" \
        "setuptools>=69.0.0" \
        paddleocr==2.10.0 \
    && python3 -m pip install --no-cache-dir --break-system-packages -e /app/packages/converter --no-deps

ENV CONVERTER_OCR_ENGINE=paddle \
    CONVERTER_PADDLE_USE_ANGLE_CLS=0

ENTRYPOINT ["converter"]
